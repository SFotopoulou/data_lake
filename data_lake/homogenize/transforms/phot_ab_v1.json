{
  "transform_id": "phot_ab_v1",
  "version": 1,
  "modality": "catalog",
  "output_system": "AB_mag",
  "description": "Catalog photometry to AB magnitudes via offsets and unit scales.",
  "rules": [
    {
      "survey": "ALLWISE",
      "source_column": "w1mpro",
      "target_column": "phot_ab_w1",
      "uncertainty_column": "w1sigmpro",
      "target_uncertainty_column": "phot_ab_w1_err",
      "native_system": "Vega",
      "transform": {"type": "mag_offset", "delta": 2.699}
    },
    {
      "survey": "ALLWISE",
      "source_column": "w2mpro",
      "target_column": "phot_ab_w2",
      "uncertainty_column": "w2sigmpro",
      "target_uncertainty_column": "phot_ab_w2_err",
      "native_system": "Vega",
      "transform": {"type": "mag_offset", "delta": 3.339}
    },
    {
      "survey": "ALLWISE",
      "source_column": "w3mpro",
      "target_column": "phot_ab_w3",
      "uncertainty_column": "w3sigmpro",
      "target_uncertainty_column": "phot_ab_w3_err",
      "native_system": "Vega",
      "transform": {"type": "mag_offset", "delta": 5.174}
    },
    {
      "survey": "ALLWISE",
      "source_column": "w4mpro",
      "target_column": "phot_ab_w4",
      "uncertainty_column": "w4sigmpro",
      "target_uncertainty_column": "phot_ab_w4_err",
      "native_system": "Vega",
      "transform": {"type": "mag_offset", "delta": 6.620}
    },
    {
      "survey": "GAIA_DR3",
      "source_column": "phot_g_mean_mag",
      "target_column": "phot_ab_g",
      "uncertainty_column": "phot_g_mean_mag_error",
      "target_uncertainty_column": "phot_ab_g_err",
      "native_system": "Vega",
      "transform": {"type": "scale", "factor": 0.001, "note": "mmag to mag"}
    },
    {
      "survey": "GAIA_DR3",
      "source_column": "phot_bp_mean_mag",
      "target_column": "phot_ab_bp",
      "uncertainty_column": "phot_bp_mean_mag_error",
      "target_uncertainty_column": "phot_ab_bp_err",
      "native_system": "Vega",
      "transform": {"type": "scale", "factor": 0.001}
    },
    {
      "survey": "GAIA_DR3",
      "source_column": "phot_rp_mean_mag",
      "target_column": "phot_ab_rp",
      "uncertainty_column": "phot_rp_mean_mag_error",
      "target_uncertainty_column": "phot_ab_rp_err",
      "native_system": "Vega",
      "transform": {"type": "scale", "factor": 0.001}
    }
  ]
}
